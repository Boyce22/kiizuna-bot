{
  "name": "kizuna-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Discord bot Kizuna. Sem TypeORM/Fastify/Svelte — fala com a API via HMAC.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "dev": "ts-node -r tsconfig-paths/register src/index.ts",
    "commands:register": "ts-node -r tsconfig-paths/register src/register-commands.ts",
    "test": "npm run build && node --test dist/slash-command-catalog.test.js dist/command-runtime.test.js dist/client.test.js dist/command-throttle.test.js",
    "typecheck": "tsc --noEmit",
    "sync:errors": "node scripts/sync-error-codes.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "discord.js": "^14.15.3",
    "dotenv": "^16.4.5",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.3"
  }
}
